# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/mcq

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Admin default (created by seed script)
ADMIN_NAME=Admin Muallim
ADMIN_EMAIL=admin@muallimcarpets.com
ADMIN_PASSWORD=Admin@123

# Manager default password (seed)
MANAGER_PASSWORD=Manager@123

# ------------------------------------------------------------------
# Email (Gmail SMTP) — used for the automatic Daily Data Report PDF.
# 1. Enable 2-Step Verification on your Gmail account.
# 2. Create an "App Password" (Google Account > Security > App passwords).
# 3. Put the 16-char app password in SMTP_PASS below.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
REPORT_RECIPIENT_EMAIL=youremail@example.com

# Cron schedule (5-field) for the daily report. Default: 21:00 every day.
DAILY_REPORT_CRON=0 21 * * *

# ------------------------------------------------------------------
# WhatsApp (Meta Cloud API) - used to send the PDF sale receipt to the
# customer's WhatsApp number after every sale that has a phone number.
# 1. Create a WhatsApp Business Account + app at developers.facebook.com.
# 2. Add the business phone number and copy the Phone Number ID (WHATSAPP_PHONE_ID).
# 3. Generate a permanent access token for the WhatsApp App (WHATSAPP_API_TOKEN).
# ------------------------------------------------------------------
WHATSAPP_API_TOKEN=your_meta_whatsapp_permanent_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
# Graph API version, e.g. v21.0.
WHATSAPP_API_VERSION=v21.0
# Destination country code used to convert local numbers (0300... -> 92300...).
WHATSAPP_COUNTRY_CODE=92
# Set to "false" to disable automatic receipt sending.
WHATSAPP_RECEIPTS_ENABLED=true

# --- WhatsApp TEST MODE ----------------------------------------------------
# While true, invoices are ONLY delivered to WHATSAPP_TEST_RECIPIENT (a
# number verified on the WhatsApp Business Account, e.g. 923001234567).
# Real customer numbers are never messaged in test mode.
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT=your_verified_test_number

# --- WhatsApp Webhook (delivery status: sent / delivered / read / failed) --
# 1. Your backend must be reachable from the internet (e.g. a tunnel such as
#    cloudflared or ngrok). Configure the webhook callback URL as:
#    https://<your-host>/api/whatsapp/webhook
# 2. SET WHATSAPP_WEBHOOK_VERIFY_TOKEN to a private random string and paste
#    the same value into the Meta "Verify token" field.
# 3. Set WHATSAPP_APP_SECRET to your Meta App Secret so every event is
#    signature-checked (X-Hub-Signature-256).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_private_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Optional: an approved "utility" template name used only as a fallback if
# document delivery is rejected (body must declare exactly 2 params).
# WHATSAPP_UTILITY_TEMPLATE=hair_invoice_2
